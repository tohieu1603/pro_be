NODE_ENV=development
PORT=3001

# PostgreSQL (docker-compose.yml ở root tạo sẵn container này)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres123
DB_DATABASE=manageproducts

# JWT — đổi sang secret mạnh trước khi deploy
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# Upload + CORS
UPLOAD_DIR=uploads
CORS_ORIGIN=http://localhost:3000
